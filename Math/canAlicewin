class Solution {
    public boolean canAliceWin(int n) {
        if(n< 10){
            return false;
        }
        int k = 10;
        int count = 1 ; // 3,4,5,6,7,8
        for(int i = 0 ; k < n ; i++ ){
             n = n -k;
             k--;
             count ++;
        }
        if(count % 2 == 0){
           return true ; 
        }
        else{
            return false ;
        }
    }
}
